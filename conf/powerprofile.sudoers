# Passwordless manual switching. Install with:
#
#   sed 's/USER/yourname/' conf/powerprofile.sudoers | sudo tee /etc/sudoers.d/powerprofile
#   sudo chmod 440 /etc/sudoers.d/powerprofile && sudo visudo -c
#
# Exact arguments only: sudo refuses everything else, --config and
# --dry-run included. Add one line per manual profile defined in
# /etc/powerprofile.conf, and adjust the path if you built with another PREFIX.
USER ALL=(root) NOPASSWD: /usr/local/bin/powerprofile --auto, \
	/usr/local/bin/powerprofile --profile battery, \
	/usr/local/bin/powerprofile --profile balanced, \
	/usr/local/bin/powerprofile --profile gaming, \
	/usr/local/bin/powerprofile --profile saver
