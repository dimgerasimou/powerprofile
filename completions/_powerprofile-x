#compdef powerprofile-x
# zsh completion for powerprofile-x
# Install as: <dir on $fpath>/_powerprofile-x
#         e.g. /usr/share/zsh/site-functions/_powerprofile-x

_powerprofile_x()
{
	local state

	_arguments -s \
		'(- *)--help[print help and exit]' \
		'(- *)--version[print version and exit]' \
		'--once[apply the current profile once and exit]' \
		'--config=[read another config file]:config file:_files' \
		'--state=[follow another state file]:state file:_files' \
		'--output=[use this output instead of the internal panel]:output:->outputs' \
		'--verbose[log actions to stderr]'

	if [[ $state == outputs ]]; then
		local -a outputs
		outputs=(${(f)"$(xrandr --query 2>/dev/null | awk '/ connected/ { print $1 }')"})
		compadd -a outputs
	fi
}

_powerprofile_x "$@"
